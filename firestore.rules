rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== GLOBAL HARDENED HELPERS ====================

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwnerEmail() {
      return isEmailVerified() && request.auth.token.email == 'khansaheb2572@gmail.com';
    }

    // Admin privilege check using dedicated server-managed /admins/{uid} collection or verified bootstrap owner email
    function isAdmin() {
      return isVerifiedOwnerEmail() || (
        isSignedIn() &&
        isEmailVerified() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ==================== VALIDATION BLUEPRINTS ====================

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'type', 'category', 'title', 'description', 'price'])
        && data.keys().hasOnly([
          'id', 'type', 'category', 'title', 'description', 'price', 'isFree', 'priceDisplay',
          'period', 'thumbnailUrl', 'iconUrl', 'launchUrl', 'protectedUrl', 'features',
          'status', 'duration', 'instructor', 'featured', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.type is string && data.type in ['Plugin', 'Course', 'Software', 'Free Tutorial', 'Agency Package']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.description is string && data.description.size() >= 0 && data.description.size() <= 3000
        && (data.price is int || data.price is float) && data.price >= 0 && data.price <= 10000000
        && (!('isFree' in data) || data.isFree is bool)
        && (!('priceDisplay' in data) || (data.priceDisplay is string && data.priceDisplay.size() <= 60))
        && (!('period' in data) || (data.period is string && data.period.size() <= 40))
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000))
        && (!('iconUrl' in data) || (data.iconUrl is string && data.iconUrl.size() <= 1000))
        && (!('launchUrl' in data) || (data.launchUrl is string && data.launchUrl.size() <= 1000))
        && (
          !('protectedUrl' in data) ||
          (data.type == 'Free Tutorial' && data.price == 0 && data.protectedUrl is string && data.protectedUrl.size() <= 1000) ||
          (data.protectedUrl is string && data.protectedUrl.size() == 0)
        )
        && (!('features' in data) || (data.features is list && data.features.size() <= 15 && (data.features.size() == 0 || data.features[0] is string)))
        && (!('status' in data) || (data.status is string && data.status in ['active', 'draft', 'archived']))
        && (!('duration' in data) || (data.duration is string && data.duration.size() <= 60))
        && (!('instructor' in data) || (data.instructor is string && data.instructor.size() <= 120))
        && (!('featured' in data) || data.featured is bool)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidProductSecret(data) {
      return data.keys().hasAll(['id', 'protectedUrl'])
        && data.keys().hasOnly(['id', 'protectedUrl', 'updatedAt'])
        && isValidId(data.id)
        && data.protectedUrl is string && data.protectedUrl.size() >= 1 && data.protectedUrl.size() <= 1000
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSetting(settingId, data) {
      return (
        settingId == 'paymentConfig' &&
        data.keys().hasOnly([
          'bKashNumber', 'nagadNumber', 'rocketNumber', 'upayNumber',
          'bankDetails', 'secondaryBankDetails', 'webAppUrl', 'whatsAppNumber'
        ]) &&
        (!('bKashNumber' in data) || (data.bKashNumber is string && data.bKashNumber.size() <= 40)) &&
        (!('nagadNumber' in data) || (data.nagadNumber is string && data.nagadNumber.size() <= 40)) &&
        (!('rocketNumber' in data) || (data.rocketNumber is string && data.rocketNumber.size() <= 40)) &&
        (!('upayNumber' in data) || (data.upayNumber is string && data.upayNumber.size() <= 40)) &&
        (!('webAppUrl' in data) || (data.webAppUrl is string && data.webAppUrl.size() <= 1000)) &&
        (!('whatsAppNumber' in data) || (data.whatsAppNumber is string && data.whatsAppNumber.size() <= 40)) &&
        (!('bankDetails' in data) || data.bankDetails is map) &&
        (!('secondaryBankDetails' in data) || data.secondaryBankDetails is map)
      ) || (
        settingId == 'adminConfig' &&
        data.keys().hasOnly(['telegramBotToken', 'telegramChatId', 'spreadsheetUrl', 'webAppUrl', 'updatedAt']) &&
        (!('telegramBotToken' in data) || (data.telegramBotToken is string && data.telegramBotToken.size() <= 300)) &&
        (!('telegramChatId' in data) || (data.telegramChatId is string && data.telegramChatId.size() <= 100)) &&
        (!('spreadsheetUrl' in data) || (data.spreadsheetUrl is string && data.spreadsheetUrl.size() <= 1000)) &&
        (!('webAppUrl' in data) || (data.webAppUrl is string && data.webAppUrl.size() <= 1000)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 80))
      );
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerName', 'customerEmail', 'customerPhone', 'itemName', 'itemPrice', 'paymentMethod', 'trxId', 'createdAt', 'status'])
        && data.keys().hasOnly([
          'id', 'userId', 'customerName', 'customerEmail', 'customerPhone',
          'itemId', 'productId', 'itemName', 'itemPrice', 'canonicalAmount',
          'paymentMethod', 'senderAccount', 'trxId', 'createdAt', 'status',
          'downloadUrl', 'licenseKey', 'verificationNote', 'approvedBy', 'approvedAt'
        ])
        && isValidId(data.id)
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 254
        && data.customerPhone is string && data.customerPhone.size() >= 4 && data.customerPhone.size() <= 40
        && (!('itemId' in data) || (data.itemId is string && data.itemId.size() <= 128))
        && (!('productId' in data) || (data.productId is string && data.productId.size() <= 128))
        && data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 200
        && data.itemPrice is string && data.itemPrice.size() >= 1 && data.itemPrice.size() <= 60
        && (!('canonicalAmount' in data) || ((data.canonicalAmount is int || data.canonicalAmount is float) && data.canonicalAmount >= 0))
        && data.paymentMethod is string && data.paymentMethod in ['bKash', 'Nagad', 'Rocket', 'Upay', 'Bank Transfer']
        && (!('senderAccount' in data) || (data.senderAccount is string && data.senderAccount.size() <= 80))
        && data.trxId is string && data.trxId.size() >= 4 && data.trxId.size() <= 60
        && data.createdAt is string && data.createdAt.size() <= 80
        && data.status is string && data.status in ['Pending', 'Verified', 'Paid', 'Completed']
        && (!('downloadUrl' in data) || (data.downloadUrl is string && data.downloadUrl.size() <= 1000))
        && (!('licenseKey' in data) || (data.licenseKey is string && data.licenseKey.size() <= 120))
        && (!('verificationNote' in data) || (data.verificationNote is string && data.verificationNote.size() <= 300))
        && (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 254))
        && (!('approvedAt' in data) || (data.approvedAt is string && data.approvedAt.size() <= 80));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'authProvider', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'phone', 'company',
          'role', 'authProvider', 'emailVerified', 'createdAt', 'updatedAt', 'lastLoginAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role is string && data.role in ['customer', 'admin']
        && data.authProvider is string && data.authProvider.size() >= 1 && data.authProvider.size() <= 60
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('company' in data) || (data.company is string && data.company.size() <= 120))
        && (!('emailVerified' in data) || data.emailVerified is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('lastLoginAt' in data) || data.lastLoginAt is timestamp);
    }

    function isValidDownloadLog(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'downloadedAt'])
        && data.keys().hasOnly(['id', 'userId', 'purchaseId', 'title', 'category', 'licenseKey', 'sessionToken', 'downloadedAt'])
        && isValidId(data.id)
        && isValidId(data.userId)
        && (!('purchaseId' in data) || (data.purchaseId is string && data.purchaseId.size() <= 128))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (!('category' in data) || (data.category is string && data.category.size() <= 80))
        && (!('licenseKey' in data) || (data.licenseKey is string && data.licenseKey.size() <= 120))
        && (!('sessionToken' in data) || (data.sessionToken is string && data.sessionToken.size() <= 120))
        && data.downloadedAt is timestamp;
    }

    function isValidMirrorPOSLicenseRequest(data) {
      return data.keys().hasAll([
          'id', 'userId', 'customerName', 'gmail', 'senderNumber', 'transactionId',
          'amount', 'accessType', 'licenseType', 'paymentStatus', 'licenseStatus',
          'submittedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'customerName', 'gmail', 'senderNumber', 'transactionId',
          'amount', 'accessType', 'licenseType', 'paymentStatus', 'licenseStatus',
          'submittedAt', 'updatedAt', 'approvedAt', 'approvedBy', 'adminNote'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && data.gmail is string && data.gmail.size() >= 5 && data.gmail.size() <= 254
        && data.senderNumber is string && data.senderNumber.size() >= 6 && data.senderNumber.size() <= 30
        && isValidId(data.transactionId)
        && data.transactionId.size() >= 4 && data.transactionId.size() <= 40
        && (data.amount is int || data.amount is float) && data.amount > 0 && data.amount <= 1000000
        && data.accessType is string && data.accessType == 'DESKTOP_LICENSE'
        && data.licenseType is string && data.licenseType == 'LIFETIME'
        && data.paymentStatus is string && data.paymentStatus in ['PENDING', 'APPROVED', 'REJECTED']
        && data.licenseStatus is string && data.licenseStatus in ['PENDING', 'ACTIVE', 'INACTIVE']
        && data.submittedAt is timestamp
        && data.updatedAt is timestamp
        && (!('approvedAt' in data) || data.approvedAt == null || data.approvedAt is timestamp)
        && (!('approvedBy' in data) || data.approvedBy == null || (data.approvedBy is string && data.approvedBy.size() <= 254))
        && (!('adminNote' in data) || data.adminNote == null || (data.adminNote is string && data.adminNote.size() <= 500));
    }

    function isValidMirrorPOSTrxLock(data) {
      return data.keys().hasAll(['trxId', 'requestId', 'userId', 'createdAt'])
        && data.keys().hasOnly(['trxId', 'requestId', 'userId', 'createdAt'])
        && isValidId(data.trxId)
        && isValidId(data.requestId)
        && isValidId(data.userId)
        && data.createdAt is timestamp;
    }

    function isValidMirrorPOSUserLicense(data) {
      return data.keys().hasAll([
          'uid', 'email', 'productId', 'accessType', 'licenseType', 'licenseStatus', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'customerName', 'productId', 'accessType', 'licenseType',
          'licenseStatus', 'requestId', 'transactionId', 'amount', 'approvedBy', 'approvedAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 254
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 120))
        && data.productId is string && data.productId == 'software-mirrorpos'
        && data.accessType is string && data.accessType == 'DESKTOP_LICENSE'
        && data.licenseType is string && data.licenseType == 'LIFETIME'
        && data.licenseStatus is string && data.licenseStatus in ['PENDING', 'ACTIVE', 'INACTIVE']
        && (!('requestId' in data) || isValidId(data.requestId))
        && (!('transactionId' in data) || (data.transactionId is string && data.transactionId.size() <= 40))
        && (!('amount' in data) || ((data.amount is int || data.amount is float) && data.amount >= 0))
        && (!('approvedBy' in data) || data.approvedBy == null || (data.approvedBy is string && data.approvedBy.size() <= 254))
        && (!('approvedAt' in data) || data.approvedAt == null || data.approvedAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function isValidMirrorPOSFreeAccess(data) {
      return data.keys().hasAll([
          'id', 'customerName', 'gmail', 'accessType', 'tokenId', 'tokenExpiresAt', 'used', 'requestedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'customerName', 'gmail', 'accessType',
          'tokenId', 'tokenExpiresAt', 'used', 'requestedAt', 'usedAt'
        ])
        && isValidId(data.id)
        && (!('userId' in data) || data.userId == null || isValidId(data.userId))
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.gmail is string && data.gmail.size() >= 5 && data.gmail.size() <= 254
        && data.accessType is string && data.accessType == 'FREE_EMAIL'
        && isValidId(data.tokenId)
        && data.tokenExpiresAt is string && data.tokenExpiresAt.size() <= 64
        && data.used is bool
        && data.requestedAt is timestamp
        && (!('usedAt' in data) || data.usedAt == null || data.usedAt is timestamp);
    }

    function isValidAdminActivityLog(data) {
      return data.keys().hasAll([
          'id', 'action', 'adminUid', 'adminEmail', 'targetRequestId', 'newStatus', 'timestamp'
        ])
        && data.keys().hasOnly([
          'id', 'action', 'adminUid', 'adminEmail', 'targetRequestId', 'targetUserId',
          'targetEmail', 'transactionId', 'previousStatus', 'newStatus', 'details', 'timestamp'
        ])
        && isValidId(data.id)
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 80
        && isValidId(data.adminUid)
        && data.adminEmail is string && data.adminEmail.size() >= 3 && data.adminEmail.size() <= 254
        && isValidId(data.targetRequestId)
        && (!('targetUserId' in data) || (data.targetUserId is string && data.targetUserId.size() <= 128))
        && (!('targetEmail' in data) || (data.targetEmail is string && data.targetEmail.size() <= 254))
        && (!('transactionId' in data) || (data.transactionId is string && data.transactionId.size() <= 40))
        && (!('previousStatus' in data) || (data.previousStatus is string && data.previousStatus.size() <= 30))
        && data.newStatus is string && data.newStatus.size() >= 2 && data.newStatus.size() <= 30
        && (!('details' in data) || (data.details is string && data.details.size() <= 500))
        && data.timestamp is timestamp;
    }

    function isValidMirrorBotWorkspace(data) {
      return data.keys().hasAll([
          'uid', 'activatedInVault', 'businessName', 'botName', 'workPoints',
          'autoReplyEnabled', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'activatedInVault', 'businessName', 'botName', 'workPoints',
          'autoReplyEnabled', 'facebookPageConnected', 'facebookPageId', 'facebookPageName',
          'messengerConnected', 'whatsappConnected', 'whatsappPhoneId', 'whatsappDisplayPhone',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.activatedInVault is bool
        && data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 100
        && data.botName is string && data.botName.size() >= 1 && data.botName.size() <= 50
        && data.workPoints is list && data.workPoints.size() <= 15 && (data.workPoints.size() == 0 || data.workPoints[0] is string)
        && data.autoReplyEnabled is bool
        && (!('facebookPageConnected' in data) || data.facebookPageConnected is bool)
        && (!('facebookPageId' in data) || (data.facebookPageId is string && data.facebookPageId.size() <= 64))
        && (!('facebookPageName' in data) || (data.facebookPageName is string && data.facebookPageName.size() <= 120))
        && (!('messengerConnected' in data) || data.messengerConnected is bool)
        && (!('whatsappConnected' in data) || data.whatsappConnected is bool)
        && (!('whatsappPhoneId' in data) || (data.whatsappPhoneId is string && data.whatsappPhoneId.size() <= 64))
        && (!('whatsappDisplayPhone' in data) || (data.whatsappDisplayPhone is string && data.whatsappDisplayPhone.size() <= 60))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ==================== COLLECTION RULES ====================

    // 1. Public Digital Store Catalog (Admin write only; paid URLs excluded)
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().id == productId;
      allow update: if isValidProduct(incoming()) && isAdmin() && isValidId(productId) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(productId);
    }

    // 1b. Protected Download URLs (Strictly Admin-only & Server Admin SDK)
    match /productSecrets/{productId} {
      allow get: if isAdmin() && isValidId(productId);
      allow list: if isVerifiedOwnerEmail();
      allow create: if isAdmin() && isValidId(productId) && isValidProductSecret(incoming()) && incoming().id == productId;
      allow update: if isValidProductSecret(incoming()) && isAdmin() && isValidId(productId) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(productId);
    }

    // 1c. Server-Only Payment & SMS Verification Collections (Admin SDK Only — zero client access)
    match /bkashTransactions/{trxId} {
      allow read, write: if false;
    }

    match /redeemedTrxIds/{trxId} {
      allow read, write: if false;
    }

    match /paymentSessions/{sessionId} {
      allow read, write: if false;
    }

    // 2. Settings: paymentConfig is public read-only for checkout; adminConfig is strictly Admin-only
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'paymentConfig' || isAdmin());
      allow list: if isVerifiedOwnerEmail();
      allow create, update: if isAdmin() && isValidId(settingId) && isValidSetting(settingId, incoming());
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // 3. Server-managed Admin Allowlist (immutable from client SDKs)
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isSignedIn() && (request.auth.uid == adminUid || isVerifiedOwnerEmail());
      allow list, create, update, delete: if false;
    }

    // 4. Customer Orders (Client creates restricted strictly to Pending with NO downloadUrl/licenseKey)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (
        isAdmin() ||
        (('userId' in existing()) && existing().userId == request.auth.uid) ||
        (isEmailVerified() && existing().customerEmail == request.auth.token.email)
      );
      allow list: if isSignedIn() && (
        isVerifiedOwnerEmail() ||
        (('userId' in resource.data) && resource.data.userId == request.auth.uid) ||
        (isEmailVerified() && resource.data.customerEmail == request.auth.token.email)
      );
      allow create: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().status == 'Pending'
        && (!('downloadUrl' in incoming()) || incoming().downloadUrl == '')
        && (!('licenseKey' in incoming()) || incoming().licenseKey == '')
        && !('approvedBy' in incoming())
        && !('approvedAt' in incoming())
        && !('canonicalAmount' in incoming())
        && (
          (isSignedIn() && ('userId' in incoming()) && incoming().userId == request.auth.uid) ||
          (!isSignedIn() && !('userId' in incoming()))
        );
      allow update: if isValidOrder(incoming()) && isAdmin() && isValidId(orderId) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // 5. Customer Profiles & Isolated Vault Subcollections
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (isVerifiedOwnerEmail() || resource.data.uid == request.auth.uid);
      allow create: if isValidId(userId)
        && isSignedIn()
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().role == 'customer' || (incoming().role == 'admin' && isVerifiedOwnerEmail()));
      allow update: if isValidUserProfile(incoming())
        && isValidId(userId)
        && isSignedIn()
        && (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            incoming().uid == existing().uid &&
            incoming().email == existing().email &&
            incoming().role == existing().role &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'phone', 'company', 'emailVerified', 'lastLoginAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);

      // Customer Purchases Subcollection (READ-ONLY for owner/admin; WRITES strictly Firebase Admin SDK only)
      match /purchases/{purchaseId} {
        allow get: if isValidId(userId) && isValidId(purchaseId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow list: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isVerifiedOwnerEmail());
        allow create, update, delete: if false;
      }

      // Customer Download History Subcollection
      match /downloads/{downloadId} {
        allow get: if isValidId(userId) && isValidId(downloadId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow list: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isVerifiedOwnerEmail());
        allow create: if isValidId(userId)
          && isValidId(downloadId)
          && isSignedIn()
          && (request.auth.uid == userId || isAdmin())
          && isValidDownloadLog(incoming())
          && incoming().id == downloadId
          && incoming().userId == userId
          && incoming().downloadedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(downloadId) && isAdmin();
      }
    }

    // 6. MirrorPOS Manual bKash Desktop License Requests
    // Customers can ONLY submit PENDING requests bound to their own UID + unique trx lock.
    // Customers can NEVER edit paymentStatus or licenseStatus. Only verified Admin can approve/reject/pending.
    match /mirrorpos_license_requests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (
        isAdmin() ||
        existing().userId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isVerifiedOwnerEmail() ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isEmailVerified()
        && isValidId(requestId)
        && isValidMirrorPOSLicenseRequest(incoming())
        && incoming().id == requestId
        && incoming().userId == request.auth.uid
        && incoming().paymentStatus == 'PENDING'
        && incoming().licenseStatus == 'PENDING'
        && incoming().accessType == 'DESKTOP_LICENSE'
        && incoming().licenseType == 'LIFETIME'
        && incoming().amount == 9999
        && !('approvedAt' in incoming())
        && !('approvedBy' in incoming())
        && !('adminNote' in incoming())
        && incoming().submittedAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/mirrorpos_trx_locks/$(incoming().transactionId));
      allow update: if isValidMirrorPOSLicenseRequest(incoming())
        && isAdmin()
        && isValidId(requestId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().transactionId == existing().transactionId
        && incoming().submittedAt == existing().submittedAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'paymentStatus', 'licenseStatus', 'approvedAt', 'approvedBy', 'adminNote', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(requestId);
    }

    // 6b. MirrorPOS Duplicate Transaction ID Lock (Zero PII, create-once atomic lock)
    match /mirrorpos_trx_locks/{trxId} {
      allow get: if isValidId(trxId) && isSignedIn();
      allow list: if isVerifiedOwnerEmail();
      allow create: if isEmailVerified()
        && isValidId(trxId)
        && isValidMirrorPOSTrxLock(incoming())
        && incoming().trxId == trxId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(trxId);
    }

    // 7. MirrorPOS Activated User Licenses (Strictly Read-Only for Customer Owner; Writes Admin-only)
    match /mirrorpos_user_licenses/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (
        isVerifiedOwnerEmail() ||
        resource.data.uid == request.auth.uid
      );
      allow create: if isAdmin()
        && isValidId(userId)
        && isValidMirrorPOSUserLicense(incoming())
        && incoming().uid == userId
        && incoming().updatedAt == request.time;
      allow update: if isValidMirrorPOSUserLicense(incoming())
        && isAdmin()
        && isValidId(userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 8. MirrorPOS Free Email Access Tracking
    match /mirrorpos_free_access/{accessId} {
      allow get: if isValidId(accessId) && isSignedIn() && (
        isAdmin() ||
        (('userId' in existing()) && existing().userId == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isVerifiedOwnerEmail() ||
        (('userId' in resource.data) && resource.data.userId == request.auth.uid)
      );
      allow create: if isEmailVerified()
        && isValidId(accessId)
        && isValidMirrorPOSFreeAccess(incoming())
        && incoming().id == accessId
        && ('userId' in incoming()) && incoming().userId == request.auth.uid
        && incoming().accessType == 'FREE_EMAIL'
        && incoming().used == false
        && incoming().requestedAt == request.time;
      allow update: if isValidMirrorPOSFreeAccess(incoming())
        && isValidId(accessId)
        && isSignedIn()
        && (
          isAdmin() ||
          (
            ('userId' in existing()) &&
            existing().userId == request.auth.uid &&
            incoming().id == existing().id &&
            incoming().userId == existing().userId &&
            incoming().gmail == existing().gmail &&
            incoming().accessType == existing().accessType &&
            incoming().tokenId == existing().tokenId &&
            incoming().requestedAt == existing().requestedAt &&
            incoming().diff(existing()).affectedKeys().hasOnly(['used', 'usedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(accessId);
    }

    // 9. Admin Activity Audit Logs (Admin create & read only; strictly immutable)
    match /admin_activity_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isVerifiedOwnerEmail();
      allow create: if isAdmin()
        && isValidId(logId)
        && isValidAdminActivityLog(incoming())
        && incoming().id == logId
        && incoming().adminUid == request.auth.uid
        && incoming().timestamp == request.time;
      allow update, delete: if false;
    }

    // 10. Mirror Bot Multi-Tenant Customer Workspaces (Strictly isolated per UID; zero OAuth tokens stored here)
    match /mirrorbot_workspaces/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (isVerifiedOwnerEmail() || resource.data.uid == request.auth.uid);
      allow create: if isValidId(userId)
        && isSignedIn()
        && request.auth.uid == userId
        && isValidMirrorBotWorkspace(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidMirrorBotWorkspace(incoming())
        && isValidId(userId)
        && isSignedIn()
        && (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            incoming().uid == existing().uid &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'activatedInVault', 'businessName', 'botName', 'workPoints', 'autoReplyEnabled',
              'facebookPageConnected', 'facebookPageId', 'facebookPageName',
              'messengerConnected', 'whatsappConnected', 'whatsappPhoneId', 'whatsappDisplayPhone',
              'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 10b. Server-Only Mirror Bot Meta OAuth Tokens & Multi-Tenant Webhook Routing (Admin SDK Only — zero client access)
    match /mirrorbot_channel_secrets/{userId} {
      allow read, write: if false;
    }

    match /mirrorbot_channel_routes/{routeId} {
      allow read, write: if false;
    }
  }
}
