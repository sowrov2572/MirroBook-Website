rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Test connection check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Public Product Catalog: accessible worldwide in real time
    match /products/{productId} {
      allow read, write: if true;
    }

    // Global Public Settings & Payment Config
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Customer Orders & Submissions
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // User Personal Vault & Digital Library (accessible to owner and customers)
    match /users/{userId} {
      allow read, write: if true;
      match /purchases/{purchaseId} {
        allow read, write: if true;
      }
    }
  }
}
