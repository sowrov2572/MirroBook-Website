# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Gmail SMTP Email Notification System (Configured in Vercel Environment Variables)
# GMAIL_USER: Your Gmail account address (e.g. yourstudio@gmail.com)
GMAIL_USER="your-email@gmail.com"

# GMAIL_APP_PASSWORD: 16-character Google App Password (generated at myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD="your-16-char-app-password"

# ADMIN_EMAIL: Recipient email address for new package order notifications (e.g. admin@mirrorbook.site or your inbox)
ADMIN_EMAIL="admin@mirrorbook.site"

# Google Apps Script Gmail Automation Endpoint (Deploy Web App as: Execute as "Me", Who has access "Anyone", /exec URL)
# APPS_SCRIPT_INQUIRY_URL="https://script.google.com/macros/s/YOUR_ACTIVE_DEPLOYMENT_ID/exec"

# APPS_SCRIPT_API_KEY: Shared secret sent via `x-api-key` header and JSON `apiKey` body field
# (Verify `data.apiKey === PropertiesService.getScriptProperties().getProperty('APPS_SCRIPT_API_KEY')` in Code.gs doPost)
APPS_SCRIPT_API_KEY=""

# APPS_SCRIPT_BEARER_TOKEN: Optional Google OAuth2 access token sent as `Authorization: Bearer <token>` on the initial hop
# Leave blank for public "Who has access: Anyone" Apps Script Web App deployments (non-Google Bearer tokens cause Google HTTP 401)
# APPS_SCRIPT_BEARER_TOKEN=""

# INQUIRY_API_KEY: Optional inbound API key checked via `x-api-key` or `Authorization: Bearer` for server-to-server calls to /api/package-order
# INQUIRY_API_KEY=""

# ==================== SMS-BASED BKASH VERIFICATION BACKEND ====================
# PAYMENT_SMS_WEBHOOK_SECRET: Strong random secret (min 16 chars) sent by owner's iPhone Shortcut in x-webhook-secret header
PAYMENT_SMS_WEBHOOK_SECRET="replace-with-strong-32-byte-random-secret"

# OWNER_BKASH_NUMBER: Studio owner's Personal bKash number that receives Send Money payments
OWNER_BKASH_NUMBER="01767079837"

# FIREBASE_SERVICE_ACCOUNT_KEY: Full JSON string (or base64-encoded JSON) of Firebase Admin SDK service account credentials
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Alternative individual Firebase Admin SDK credentials (if FIREBASE_SERVICE_ACCOUNT_KEY is not used)
# FIREBASE_PROJECT_ID="gen-lang-client-0913481345"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@gen-lang-client-0913481345.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# FIREBASE_DATABASE_ID: Custom Firestore database ID for this project
FIREBASE_DATABASE_ID="ai-studio-mirrorbookreflec-fe0670c8-e16c-43f8-9a82-2943f7012d01"

# FREE_ACCESS_TOKEN_SECRET: Strong secret (min 16 chars) for signing single-use MirrorPOS Free Access email verification links
FREE_ACCESS_TOKEN_SECRET="replace-with-strong-32-byte-random-secret"
