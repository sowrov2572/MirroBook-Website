# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Gmail SMTP Email Delivery System (Configured in Vercel Production Environment Variables)
# GMAIL_USER: Your Gmail account address (e.g. mirrorbook.site@gmail.com)
GMAIL_USER="mirrorbook.site@gmail.com"

# GMAIL_APP_PASSWORD: 16-character Google App Password (generated at myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD="your-16-char-app-password"

# ADMIN_EMAIL: Optional recipient email for admin inquiry/order alerts (defaults to GMAIL_USER)
ADMIN_EMAIL="mirrorbook.site@gmail.com"

# Optional SMTP overrides (defaults: smtp.gmail.com / port 465 SSL)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"

# ==================== SMS-BASED BKASH VERIFICATION BACKEND ====================
# PAYMENT_SMS_WEBHOOK_SECRET: Strong random secret (min 16 chars) sent by owner's iPhone Shortcut in x-webhook-secret header
PAYMENT_SMS_WEBHOOK_SECRET="replace-with-strong-32-byte-random-secret"

# OWNER_BKASH_NUMBER: Studio owner's Personal bKash number that receives Send Money payments
OWNER_BKASH_NUMBER="01767079837"

# FIREBASE_SERVICE_ACCOUNT_KEY: Full JSON string (or base64-encoded JSON) of Firebase Admin SDK service account credentials
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Alternative individual Firebase Admin SDK credentials (if FIREBASE_SERVICE_ACCOUNT_KEY is not used)
# FIREBASE_PROJECT_ID="gen-lang-client-0913481345"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@gen-lang-client-0913481345.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# FIREBASE_DATABASE_ID: Custom Firestore database ID for this project
FIREBASE_DATABASE_ID="ai-studio-mirrorbookreflec-fe0670c8-e16c-43f8-9a82-2943f7012d01"

# FREE_ACCESS_TOKEN_SECRET: Strong secret (min 16 chars) for signing single-use MirrorPOS Free Access email verification links
FREE_ACCESS_TOKEN_SECRET="replace-with-strong-32-byte-random-secret"

# ==================== MIRROR BOT META (FACEBOOK MESSENGER & WHATSAPP) ====================
# META_APP_ID: Meta App ID for Facebook Business Login / Messenger & WhatsApp integration
META_APP_ID=""
# META_APP_SECRET: Meta App Secret for verifying x-hub-signature-256 on incoming webhooks
META_APP_SECRET=""
# META_WEBHOOK_VERIFY_TOKEN (or alias META_VERIFY_TOKEN): Verify token configured in Meta App Dashboard Webhooks
META_WEBHOOK_VERIFY_TOKEN=""
# GRAPH_API_VERSION: Meta Graph API version used for Messenger Send API & Page subscriptions (default: v21.0)
GRAPH_API_VERSION="v21.0"
# META_TOKEN_ENCRYPTION_KEY: Optional 32+ char secret for AES-256-GCM encryption of per-tenant Meta tokens at rest (defaults to key derived from META_APP_SECRET)
META_TOKEN_ENCRYPTION_KEY=""
# META_PAGE_ACCESS_TOKEN: Page Access Token for the MirrorBook Facebook Page (used as owner fallback when OAuth token is not persisted)
META_PAGE_ACCESS_TOKEN=""
# META_FALLBACK_PAGE_ID (or alias META_PAGE_ID): Facebook Page ID restricting META_PAGE_ACCESS_TOKEN fallback to a single Page
META_FALLBACK_PAGE_ID=""
# WHATSAPP_ACCESS_TOKEN: Optional fallback Meta WhatsApp Cloud API token (for owner quick-testing before OAuth connect)
WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID: WhatsApp Business Cloud API Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=""

