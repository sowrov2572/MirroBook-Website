{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A digital product, plugin, software, tutorial, or agency package (non-tutorial items exclude protectedUrl)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["Plugin", "Course", "Software", "Free Tutorial", "Agency Package"] },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "isFree": { "type": "boolean" },
        "priceDisplay": { "type": "string" },
        "period": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "iconUrl": { "type": "string" },
        "launchUrl": { "type": "string" },
        "protectedUrl": { "type": "string" },
        "features": { "type": "array", "description": "Bounded feature highlights (max 15 items)" },
        "status": { "type": "string", "enum": ["active", "draft", "archived"] },
        "duration": { "type": "string" },
        "instructor": { "type": "string" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "type", "category", "title", "description", "price"]
    },
    "ProductSecret": {
      "title": "ProductSecret",
      "description": "Admin-only & Admin-SDK-only protected download/access URLs for paid and downloadable catalog items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "protectedUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "protectedUrl"]
    },
    "PaymentConfig": {
      "title": "PaymentConfig",
      "description": "Public payment account numbers and bank transfer instructions",
      "type": "object",
      "properties": {
        "bKashNumber": { "type": "string" },
        "nagadNumber": { "type": "string" },
        "rocketNumber": { "type": "string" },
        "upayNumber": { "type": "string" },
        "bankDetails": { "type": "object" },
        "secondaryBankDetails": { "type": "object" },
        "webAppUrl": { "type": "string" },
        "whatsAppNumber": { "type": "string" }
      }
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Admin-only private secrets such as Telegram Bot credentials and Google Sheet spreadsheet URL",
      "type": "object",
      "properties": {
        "telegramBotToken": { "type": "string" },
        "telegramChatId": { "type": "string" },
        "spreadsheetUrl": { "type": "string" },
        "webAppUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "BkashTransaction": {
      "title": "BkashTransaction",
      "description": "Trusted server-side SMS webhook payment event recorded exclusively via Firebase Admin SDK",
      "type": "object",
      "properties": {
        "trxId": { "type": "string" },
        "gateway": { "type": "string" },
        "transactionType": { "type": "string" },
        "amount": { "type": "number" },
        "sender": { "type": "string" },
        "recipientAccount": { "type": "string" },
        "ownerBkashNumber": { "type": "string" },
        "rawText": { "type": "string" },
        "rawTextHash": { "type": "string" },
        "smsTimestamp": { "type": "string" },
        "receivedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["UNUSED", "USED"] },
        "verifiedByWebhook": { "type": "boolean" },
        "usedByOrderId": { "type": "string" },
        "usedByUid": { "type": "string" },
        "usedByEmail": { "type": "string" },
        "redeemedAt": { "type": "string" }
      },
      "required": ["trxId", "gateway", "amount", "status", "verifiedByWebhook", "receivedAt"]
    },
    "RedeemedTransaction": {
      "title": "RedeemedTransaction",
      "description": "Atomic transaction lock record preventing duplicate TrxID redemption across orders",
      "type": "object",
      "properties": {
        "trxId": { "type": "string" },
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "customerEmail": { "type": "string" },
        "amount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["trxId", "orderId", "amount", "createdAt"]
    },
    "PaymentSession": {
      "title": "PaymentSession",
      "description": "Server-only payment checkout verification session state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "status", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer purchase or payment verification order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "itemId": { "type": "string" },
        "productId": { "type": "string" },
        "itemName": { "type": "string" },
        "itemPrice": { "type": "string" },
        "canonicalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "senderAccount": { "type": "string" },
        "trxId": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Verified", "Paid", "Completed"] },
        "downloadUrl": { "type": "string" },
        "licenseKey": { "type": "string" },
        "verificationNote": { "type": "string" },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string" }
      },
      "required": ["id", "customerName", "customerEmail", "itemName", "trxId", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile isolated to the user UID or verified studio owner",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "authProvider": { "type": "string" },
        "emailVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "authProvider", "createdAt", "updatedAt"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "A secured digital asset license unlocked exclusively by Firebase Admin SDK for an authenticated customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "purchasedAt": { "type": "string" },
        "trxId": { "type": "string" },
        "licenseKey": { "type": "string" }
      },
      "required": ["id", "title", "downloadUrl"]
    },
    "DownloadLog": {
      "title": "DownloadLog",
      "description": "Audit log of digital asset downloads by an authenticated customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "purchaseId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "licenseKey": { "type": "string" },
        "sessionToken": { "type": "string" },
        "downloadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "downloadedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Server-managed allowlist document identifying verified Studio Owner UIDs",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public catalog of agency packages, plugins, software, tutorials, and courses (never stores paid protectedUrl)"
    },
    "/productSecrets/{productId}": {
      "schema": "ProductSecret",
      "description": "Admin-only protected download URLs for paid digital products"
    },
    "/bkashTransactions/{trxId}": {
      "schema": "BkashTransaction",
      "description": "Server-only incoming bKash SMS webhook events verified atomically by Firebase Admin SDK"
    },
    "/redeemedTrxIds/{trxId}": {
      "schema": "RedeemedTransaction",
      "description": "Server-only transaction redemption lock documents preventing TrxID reuse"
    },
    "/paymentSessions/{sessionId}": {
      "schema": "PaymentSession",
      "description": "Server-only checkout verification sessions"
    },
    "/settings/{settingId}": {
      "schema": "PaymentConfig",
      "description": "Public paymentConfig vs admin-only adminConfig secrets"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer payment verification and manual review orders"
    },
    "/admins/{adminUid}": {
      "schema": "AdminRecord",
      "description": "Immutable admin allowlist checked for elevated privileges"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Customer and owner profile documents strictly isolated per UID"
    },
    "/users/{userId}/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Secured user downloads and digital licenses written strictly by Firebase Admin SDK"
    },
    "/users/{userId}/downloads/{downloadId}": {
      "schema": "DownloadLog",
      "description": "Per-user download history audit records"
    }
  }
}
